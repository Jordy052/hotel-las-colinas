# Copia este archivo como .env y completa tus propios datos.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=hotel_reservas
MYSQL_CONNECT_TIMEOUT=5

# Cuenta administradora inicial. Elige una contraseña privada de 12 a 30 caracteres.
HOTEL_BOOTSTRAP_ADMIN_EMAIL=admin.hotel@hotellascolinas.com
HOTEL_BOOTSTRAP_ADMIN_PASSWORD=
HOTEL_BOOTSTRAP_ADMIN_NAME=Administrador
HOTEL_NAME=Hotel Las Colinas

# Remitente de códigos de registro y recuperación. Gmail requiere contraseña de aplicación.
HOTEL_SMTP_HOST=smtp.gmail.com
HOTEL_SMTP_PORT=587
HOTEL_SMTP_USERNAME=
HOTEL_SMTP_PASSWORD=
HOTEL_SMTP_FROM=
HOTEL_SMTP_STARTTLS=true

# Genera una clave aleatoria larga y privada.
HOTEL_PASSWORD_RESET_SECRET=

# Alojamiento de la API (opcional; no reemplaza la configuración local).
# Origen HTTPS sin /api ni barra final; se usa también para las fotografías.
HOTEL_PUBLIC_BASE_URL=
HOTEL_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
# Activa TLS para MySQL remoto. En Aiven, usa su certificado CA completo.
MYSQL_SSL=false
MYSQL_SSL_CA=
MYSQL_SSL_CA_PEM=

# Render Free bloquea SMTP. Para correo HTTPS usa un remitente verificado en Brevo.
# La instalación local conserva SMTP si estas opciones se dejan con sus valores por defecto.
HOTEL_EMAIL_PROVIDER=smtp
HOTEL_EMAIL_FROM=
HOTEL_BREVO_API_KEY=

# Alternativa gratuita con Gmail mediante Google Apps Script (HTTPS).
HOTEL_GOOGLE_MAIL_URL=
HOTEL_GOOGLE_MAIL_SECRET=
