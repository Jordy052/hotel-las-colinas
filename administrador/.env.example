# Copia este archivo como .env y completa tus propios datos.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=hotel_reservas
MYSQL_CONNECT_TIMEOUT=5

# Cuenta administradora inicial. Elige una contraseña privada de 12 a 30 caracteres.
HOTEL_BOOTSTRAP_ADMIN_EMAIL=admin.hotel@hotellascolinas.com
HOTEL_BOOTSTRAP_ADMIN_PASSWORD=
HOTEL_BOOTSTRAP_ADMIN_NAME=Administrador
HOTEL_NAME=Hotel Las Colinas

# Remitente de códigos de registro y recuperación. Gmail requiere contraseña de aplicación.
HOTEL_SMTP_HOST=smtp.gmail.com
HOTEL_SMTP_PORT=587
HOTEL_SMTP_USERNAME=
HOTEL_SMTP_PASSWORD=
HOTEL_SMTP_FROM=
HOTEL_SMTP_STARTTLS=true

# Genera una clave aleatoria larga y privada.
HOTEL_PASSWORD_RESET_SECRET=
